NODE_ENV=development

# Database
DATABASE_URL=postgresql://mesa:mesa@localhost:5432/mesa

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# Anthropic (NLP + OCR)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Business API (via BSP e.g. Termii)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional — only needed for the worker's startup self-heal that checks/
# restores the WABA's webhook subscription.
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mesa_webhook_verify_token_change_me
WHATSAPP_APP_SECRET=
WHATSAPP_LOGIN_TEMPLATE_NAME=
WHATSAPP_LOGIN_TEMPLATE_LANGUAGE=en_US
# Optional — name of the approved template sent after onboarding connects.
WHATSAPP_WELCOME_TEMPLATE_NAME=

# Meta Embedded Signup (WhatsApp)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/onboarding/whatsapp/callback

# Instagram API with Instagram Login — a distinct companion app/credentials
# from the WhatsApp Meta app above, not interchangeable.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/onboarding/instagram/callback
# Optional — falls back to WHATSAPP_WEBHOOK_VERIFY_TOKEN if unset
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
# Optional — plan codes for the subscription tiers; unset disables upgrade checkout.
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_GROWTH_PLAN_CODE=
PAYSTACK_BUSINESS_PLAN_CODE=
PAYSTACK_CALLBACK_URL=

# Internal
INTERNAL_API_KEY=dev_internal_key_change_me

# Sentry (optional — error tracking)
SENTRY_DSN=

# Dashboard (Vite — must be prefixed VITE_ to be exposed via import.meta.env)
VITE_API_URL=http://localhost:3002
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_REDIRECT_URI=http://localhost:3000/onboarding/whatsapp/callback
VITE_INSTAGRAM_APP_ID=
VITE_META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/onboarding/instagram/callback

# Mono
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
VITE_MONO_PUBLIC_KEY=

# Delivery dispatch (optional — platform-level accounts, not per-merchant).
# FEZ covers nationwide/interstate; Kwik is same-city (Lagos/Abuja) on-demand
# only. Both gated by DELIVERY_INTEGRATIONS_ENABLED. See
# apps/worker/src/delivery/resolver.ts for the selection rule.
FEZ_API_BASE_URL=https://apisandbox.fezdelivery.co/v1
FEZ_USER_ID=
FEZ_PASSWORD=
FEZ_SECRET_KEY=
KWIK_API_BASE_URL=
KWIK_VENDOR_EMAIL=
KWIK_VENDOR_PASSWORD=
DELIVERY_INTEGRATIONS_ENABLED=false

# Cloudflare R2 (payment screenshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mesa-screenshots
R2_ENDPOINT=
R2_PUBLIC_URL=

# URLs
DASHBOARD_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3002

# Ports
GATEWAY_PORT=3001
API_PORT=3002
WORKER_PORT=3003

# Outbox publisher: off | shadow | active (see packages/config/src/index.ts)
OUTBOX_MODE=active

# Comma-separated browser origins allowed to call the API; unset reflects any origin.
CORS_ALLOWED_ORIGINS=

# Meta App Review reviewer login bypass (optional — leave unset outside review)
APP_REVIEW_TEST_PHONE=
APP_REVIEW_TEST_CODE=

# apps/worker/src/events/replay.ts one-off script: "orders" or "payments"
REPLAY_TARGET=
