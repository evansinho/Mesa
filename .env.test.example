# Copy to .env.test and adjust as needed. Used by `pnpm test:integration`.
NODE_ENV=test

DATABASE_URL=postgres://mesa:mesa@localhost:5433/mesa_test
REDIS_URL=redis://localhost:6380
NATS_URL=nats://localhost:4223

# Test-only credentials. NEVER use real secrets here.
ANTHROPIC_API_KEY=test-anthropic-key
WHATSAPP_ACCESS_TOKEN=test-wa-token
WHATSAPP_PHONE_NUMBER_ID=test-phone-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=test-verify-token
WHATSAPP_APP_SECRET=test-app-secret
META_APP_SECRET=test-meta-app-secret
INSTAGRAM_APP_ID=test-ig-app
INSTAGRAM_APP_SECRET=test-ig-app-secret
WHATSAPP_LOGIN_TEMPLATE_LANGUAGE=en_US
PAYSTACK_SECRET_KEY=test-paystack
MONO_SECRET_KEY=test-mono
INTERNAL_API_KEY=test-internal
