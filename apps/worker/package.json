{
  "name": "@mesa/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node -r ts-node/register/transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "events:replay": "tsx src/events/replay.ts",
    "sweep": "node -r ts-node/register/transpile-only src/scripts/run-sweep.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/credential-provider-node": "^3.972.12",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@mesa/ai": "workspace:*",
    "@mesa/config": "workspace:*",
    "@mesa/db": "workspace:*",
    "@mesa/messaging": "workspace:*",
    "@mesa/nats": "workspace:*",
    "@mesa/types": "workspace:*",
    "@mesa/whatsapp": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-prometheus": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@sentry/node": "^7.119.0",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
