{
  "name": "mesa",
  "private": true,
  "scripts": {
    "dev": "turbo dev --concurrency=12",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @mesa/db db:generate",
    "db:migrate": "pnpm --filter @mesa/db db:migrate",
    "db:push": "pnpm --filter @mesa/db db:push",
    "db:studio": "pnpm --filter @mesa/db db:studio",
    "db:seed": "pnpm --filter @mesa/db db:seed",
    "clean": "find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete && find . -name 'dist' -not -path '*/node_modules/*' -type d -exec rm -rf {} + 2>/dev/null; echo 'cleaned'",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v",
    "docker:app:up": "docker compose -f docker-compose.app.yml up -d --build",
    "docker:app:down": "docker compose -f docker-compose.app.yml down",
    "tunnel": "cloudflared tunnel --url http://localhost:3001",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest",
    "test:integration": "MESA_RUN_INTEGRATION=1 jest --runInBand --forceExit",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait && DATABASE_URL=postgres://mesa:mesa@localhost:5433/mesa_test pnpm db:migrate",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:full": "pnpm test:integration:up && (pnpm test:integration; code=$?; pnpm test:integration:down; exit $code)",
    "test:coverage": "jest --coverage",
    "commercial:seed": "pnpm --filter @mesa/api seed:commercial",
    "commercial:sweep": "pnpm --filter @mesa/worker sweep",
    "commercial:reset": "pnpm commercial:seed && pnpm commercial:sweep"
  },
  "devDependencies": {
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "dotenv": "^17.4.2",
    "eslint": "^10.13.0",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "msw": "^2.14.6",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@smithy/types": "^4.14.1"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
