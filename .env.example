NODE_ENV=development

# Database
DATABASE_URL=postgresql://mesa:mesa@localhost:5432/mesa

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# Anthropic (NLP + OCR)
ANTHROPIC_API_KEY=sk-ant-...

# 360dialog BSP (WhatsApp — partner-level credentials; per-merchant keys stored in DB)
D360_PARTNER_ID=your_partner_id
D360_PARTNER_TOKEN=your_partner_token
D360_SANDBOX=false

# WhatsApp (Meta Cloud API — only if NOT using 360dialog)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mesa_webhook_verify_token_change_me
# WHATSAPP_APP_SECRET=

# Meta OAuth (Instagram only)
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/onboarding/instagram/callback

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...

# Internal
INTERNAL_API_KEY=dev_internal_key_change_me

# Dashboard (Vite)
VITE_API_URL=http://localhost:3002
VITE_D360_PARTNER_ID=your_partner_id
VITE_D360_REDIRECT_URI=http://localhost:3000/onboarding/whatsapp/callback
VITE_D360_SANDBOX=false
VITE_META_APP_ID=
VITE_META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/onboarding/instagram/callback

# Mono
MONO_SECRET_KEY=

# Cloudflare R2 (payment screenshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mesa-screenshots

# Ports
GATEWAY_PORT=3001
API_PORT=3002
WORKER_PORT=3003
